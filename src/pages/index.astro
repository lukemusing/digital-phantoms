---
// Import fonts via Google Fonts in <head> or locally
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Digital Phantoms — Luke P.D.</title>
  
  <!-- Inter & JetBrains Mono Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>

  <!-- Outer Bezel / Chassis Frame -->
  <div class="device-frame">
    
    <!-- Active Screen Surface -->
    <main class="screen-canvas">
      
      <!-- Meta / Terminal Status Header -->
      <header class="terminal-header">
        <span class="mono-tag">// LOG_AUTHOR [UNVERIFIED]: Luke P.D.</span>
        <span class="mono-status">[STATUS: ONLINE]</span>
      </header>

      <!-- Main Title Block -->
      <section class="hero">
        <h1 class="title">DIGITAL PHANTOMS</h1>
        <p class="subtitle">Living in the mirror of AI and social media</p>
      </section>

      <!-- System Alert / Code Inset Frame -->
      <div class="terminal-alert">
        <code>// CONTAINS CHAPTERS KNOWN TO CAUSE HALLUCINATIONS</code>
      </div>

      <!-- Main Prose Content Surface -->
      <article class="content-body">
        <p class="lead">
          An exploration of simulation, language games, and identity in an age governed by statistical pattern mirrors.
        </p>
        
        <p>
          We build digital architectures that echo our thoughts back to us, mistaking the reflection for context and the syntax for intent. <i>Digital Phantoms</i> examines how human consciousness navigates the boundary between authentic presence and algorithmic representation.
        </p>
      </article>

      <!-- Footer / Metadata Deck -->
      <footer class="terminal-footer">
        <div class="footer-meta">
          <span>// SYS_VER 1.0.0</span>
          <span>© 2026 LUKE P.D.</span>
        </div>
      </footer>

    </main>
  </div>

</body>
</html>

<style>
  /* ----------------------------------------------------
     CSS VARIABLES & PALETTE SETUP
  ---------------------------------------------------- */
  :root {
    --bg-bezel: #000000;      /* Pure black outer device frame */
    --bg-screen: #0F0F0F;     /* Screen surface background */
    --border-frame: #2A2A2E;  /* Structural seam / border frame */
    
    --text-main: #FFFFFF;     /* Crisp white text for main content */
    --text-muted: #8B949E;    /* Lower contrast for metadata and tags */
    
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  /* ----------------------------------------------------
     RESET & BASE LAYOUT
  ---------------------------------------------------- */
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background-color: var(--bg-bezel);
    color: var(--text-main);
    font-family: var(--font-sans);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* ----------------------------------------------------
     DEVICE FRAME & SCREEN CONTAINER
  ---------------------------------------------------- */
  .device-frame {
    width: 100%;
    max-width: 720px;
    background-color: var(--bg-bezel);
    border: 1px solid var(--border-frame);
    border-radius: 12px;
    padding: 12px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8);
  }

  .screen-canvas {
    background-color: var(--bg-screen);
    border: 1px solid var(--border-frame);
    border-radius: 6px;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* ----------------------------------------------------
     TERMINAL HEADERS & META TEXT
  ---------------------------------------------------- */
  .terminal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-frame);
    padding-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .mono-tag {
    letter-spacing: 0.02em;
  }

  .mono-status {
    color: var(--text-main);
    opacity: 0.8;
  }

  /* ----------------------------------------------------
     HERO & TYPOGRAPHY
  ---------------------------------------------------- */
  .hero {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--text-main);
  }

  .subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    font-style: italic;
    color: var(--text-muted);
    font-weight: 400;
  }

  /* ----------------------------------------------------
     TERMINAL INSET BOX
  ---------------------------------------------------- */
  .terminal-alert {
    background-color: var(--bg-bezel);
    border: 1px solid var(--border-frame);
    padding: 0.85rem 1rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
    overflow-x: auto;
  }

  /* ----------------------------------------------------
     CONTENT BODY
  ---------------------------------------------------- */
  .content-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    line-height: 1.65;
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .lead {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--text-main);
  }

  /* ----------------------------------------------------
     FOOTER
  ---------------------------------------------------- */
  .terminal-footer {
    border-top: 1px solid var(--border-frame);
    padding-top: 1.25rem;
    margin-top: 1rem;
  }

  .footer-meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* ----------------------------------------------------
     MOBILE RESPONSIVENESS
  ---------------------------------------------------- */
  @media (max-width: 600px) {
    body {
      padding: 0.5rem;
    }

    .device-frame {
      padding: 6px;
      border-radius: 8px;
    }

    .screen-canvas {
      padding: 1.5rem 1.25rem;
      gap: 1.5rem;
    }

    .terminal-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .footer-meta {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
